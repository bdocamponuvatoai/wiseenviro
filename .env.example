# Copy to .env.local for local development. Never commit real values.

# Public site URL, used for canonical links, sitemap, robots and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.wiseenviro.com

# Where contact and careers form submissions are POSTed as JSON
# (Zapier/Make/n8n webhook, CRM inbound webhook, or an email service endpoint).
# Required in production: without it, forms tell visitors to call instead of losing the lead.
LEAD_WEBHOOK_URL=

# Optional bearer token sent as `Authorization: Bearer <secret>` with each lead.
LEAD_WEBHOOK_SECRET=
